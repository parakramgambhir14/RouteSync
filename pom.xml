<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.routesync</groupId>
    <artifactId>routesync-app</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!--
        Dependencies are downloaded automatically from Maven Central the first
        time you build/run — no manual jar downloads needed.

        Using SQLite here: the whole database is one file (data/routesync.db),
        no server to install or run. If you'd rather use a server-based database
        later, swap this block:
          MySQL:      groupId=com.mysql,      artifactId=mysql-connector-j, version=8.4.0
          PostgreSQL: groupId=org.postgresql,  artifactId=postgresql,       version=42.7.3
          SQL Server: groupId=com.microsoft.sqlserver, artifactId=mssql-jdbc, version=12.6.2.jre11
        ...and update db.driver / db.url in src/main/resources/db.properties to match.
    -->
    <dependencies>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.0.0</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>routesync-app</finalName>
        <plugins>
            <!-- Compiles the code (versions pinned so behavior is predictable across machines) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!-- Lets you run the app with a single command: mvn compile exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>com.routesync.Main</mainClass>
                </configuration>
            </plugin>

            <!--
                Bundles the app + the JDBC driver into one self-contained jar via:
                  mvn package
                Then just double-click / run: java -jar target/routesync-app.jar
                (handy for sharing the app without sharing a pom.xml + source tree)
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.routesync.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
